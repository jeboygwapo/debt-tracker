# App
SECRET_KEY=generate-with-python3-secrets-token-hex-32
APP_ENV=production
APP_USER=admin
APP_PASSWORD=changeme-on-first-run-will-auto-hash

# Database
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}
DB_USER=debttracker
DB_PASSWORD=change-me
DB_NAME=debttracker

# Registration (set true to allow self-signup, false for invite-only)
ALLOW_REGISTRATION=false

# Email verification (required for public signup; needs RESEND_API_KEY)
EMAIL_VERIFICATION_REQUIRED=false

# Email delivery (Resend). FROM domain must be verified in Resend dashboard.
RESEND_API_KEY=re_your_key_here
APP_BASE_URL=http://localhost:5050

# OpenAI (optional)
OPENAI_API_KEY=sk-...

# Server
PORT=5050
